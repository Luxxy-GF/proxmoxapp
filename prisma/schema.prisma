generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  balance       Float     @default(0.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  invoices      Invoice[]
  servers       Server[]
  subusers      ServerUser[]
  sessions      Session[]
  isos          Iso[]
  dedicatedServers DedicatedServer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Node {
  id            String   @id @default(cuid())
  name          String
  address       String
  proxmoxId     String
  endpoint      String
  tokenId       String
  tokenSecret   String
  cotermEndpoint String?  // WebSocket URL for coterm (e.g., ws://proxmox:8080)
  cotermSecret   String?  // JWT secret for token generation
  cpuUsage      Float    @default(0)
  ramUsage      Float    @default(0)
  diskUsage     Float    @default(0)
  status        String   @default("Offline")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  servers       Server[]
  ipPools       IPPool[]
  isos          Iso[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Float
  billingCycle String   @default("MONTHLY")
  cpuCores     Int
  memoryMB     Int
  diskGB       Int
  type         String   @default("lxc")
  templateId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  servers      Server[]
}

model Server {
  id            String               @id @default(cuid())
  name          String               // Hostname or label
  status        String               @default("PROVISIONING")
  billingStatus String               @default("ACTIVE")
  vmid          Int?
  type          String
  userId        String
  nodeId        String
  productId     String?
  templateId    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  
  // General Settings
  displayName   String?              // User-friendly display name
  description   String?              // Optional notes/description
  timezone      String               @default("UTC")
  
  // Power & Behavior
  autoStart     Boolean              @default(false)
  
  // Console & Access
  consoleType   String               @default("xtermjs") // "xtermjs" or "novnc"
  consoleDisabled Boolean            @default(false)
  
  // Backup Settings
  backupEnabled   Boolean            @default(false)
  backupSchedule  String             @default("daily") // "daily" or "weekly"
  backupRetention Int                @default(7)
  backupMode      String             @default("snapshot") // "snapshot" or "stop"
  allowRestore    Boolean            @default(true)
  
  // Network Settings
  firewallProfile String?
  reverseDns      String?
  
  // Security Settings
  sshKeysOnly     Boolean            @default(false)
  
  subscription  BillingSubscription?
  node          Node                 @relation(fields: [nodeId], references: [id])
  product       Product?             @relation(fields: [productId], references: [id])
  template      Template?            @relation(fields: [templateId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  network       ServerNetwork?
  resources     ServerResources?
  iso           Iso?                 @relation(fields: [isoId], references: [id])
  isoId         String?
  subusers      ServerUser[]
  ips           IPAllocation[]

  @@unique([nodeId, vmid])
}

model ServerResources {
  id        String   @id @default(cuid())
  serverId  String   @unique
  cpuCores  Int
  memoryMB  Int
  diskGB    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model ServerNetwork {
  id         String   @id @default(cuid())
  serverId   String   @unique
  ipAddress  String?
  macAddress String?
  gateway    String?
  netmask    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model BillingSubscription {
  id                 String    @id @default(cuid())
  serverId           String    @unique
  amount             Float
  currency           String    @default("USD")
  status             String
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  server             Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  invoices           Invoice[]
}

model Invoice {
  id             String               @id @default(cuid())
  userId         String
  subscriptionId String?
  amount         Float
  status         String
  dueDate        DateTime
  paidAt         DateTime?
  items          Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  subscription   BillingSubscription? @relation(fields: [subscriptionId], references: [id])
  user           User                 @relation(fields: [userId], references: [id])
}

model TemplateGroup {
  id        String     @id @default(cuid())
  name      String
  templates Template[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Template {
  id        String        @id @default(cuid())
  name      String
  vmid      Int
  image     String?       // URL for the OS logo
  type      String        @default("qemu") // "lxc" or "qemu"
  groupId   String
  group     TemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  servers   Server[]
}

model ServerUser {
  id          String   @id @default(cuid())
  serverId    String
  userId      String
  permissions Json     @default("[]") // Array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model IPPool {
  id          String   @id @default(cuid())
  name        String
  nodeId      String?
  ipVersion   String   @default("v4") // "v4" or "v6"
  startIP     String
  endIP       String
  gateway     String
  netmask     String
  bridge      String   @default("vmbr0")
  vlan        Int?
  dns         String?
  mtu         Int?
  enabled     Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node        Node?          @relation(fields: [nodeId], references: [id])
  allocations IPAllocation[]
}

model IPAllocation {
  id        String   @id @default(cuid())
  poolId           String
  serverId         String?
  dedicatedServerId String?
  ipAddress        String
  createdAt        DateTime @default(now())

  pool             IPPool           @relation(fields: [poolId], references: [id])
  server           Server?          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  dedicatedServer  DedicatedServer? @relation(fields: [dedicatedServerId], references: [id], onDelete: Cascade)

  @@unique([poolId, ipAddress]) // Prevent duplicate allocation of same IP
}

model Iso {
  id          String   @id @default(cuid())
  name        String
  filename    String
  size        BigInt   // Size in bytes
  status      String   // "Uploaded", "In Use"
  storage     String   // "local" or other Proxmox storage
  nodeId      String
  userId      String
  
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  node        Node     @relation(fields: [nodeId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  servers     Server[] // Optional: Track usage
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Bare Metal / Dedicated Servers ---

model DedicatedServer {
  id            String    @id @default(cuid())
  userId        String?
  nodeId        String?   // Optional physical location/node reference
  
  hostname      String
  macAddress    String    @unique // Primary MAC for PXE
  primaryIpv4   String?
  gateway       String?
  netmask       String?
  nameservers   String?   // comma separated
  vlanId        Int?
  rack          String?
  
  status        String    @default("OFFLINE") // OFFLINE, INSTALLING, ACTIVE, ERROR
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User?     @relation(fields: [userId], references: [id])
  hardware      DedicatedHardware?
  events        DedicatedEvent[]
  assignments   ConnectionAssignment[]
  installs      PXEInstall[]
  allocations   IPAllocation[]
}

model DedicatedHardware {
  id            String          @id @default(cuid())
  serverId      String          @unique
  
  cpuModel      String
  cpuCores      Int
  ramMiB        Int
  disksJson     Json?           // e.g. [{name: "sda", size: "1TB", type: "NVMe"}]
  nicsJson      Json?           // Additional NICs
  vendor        String?
  model         String?
  serial        String?

  server        DedicatedServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model DedicatedEvent {
  id            String          @id @default(cuid())
  serverId      String
  type          String          // POWER, PXE, INSTALL, CONSOLE, INVENTORY
  message       String
  payloadJson   Json?
  
  createdAt     DateTime        @default(now())

  server        DedicatedServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// --- Connections (IPMI, DHCP, PXE Providers) ---

model Connection {
  id            String    @id @default(cuid())
  type          String    // IPMI, DHCP, PXE
  name          String
  description   String?
  encryptedConfig String? // Encrypted JSON config (host, user, pass, etc.)
  agentId       String?   // For remote agents
  enabled       Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments   ConnectionAssignment[]
}

model ConnectionAssignment {
  id            String      @id @default(cuid())
  serverId      String
  connectionId  String
  role          String      @default("PRIMARY") // PRIMARY, FALLBACK
  
  createdAt     DateTime    @default(now())

  server        DedicatedServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  connection    Connection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([serverId, connectionId])
}

// --- PXE Manager ---

model PXEProfile {
  id            String    @id @default(cuid())
  name          String
  kind          String    // INSTALL, RESCUE, INVENTORY
  osFamily      String    // DEBIAN, UBUNTU, ALMALINUX, OTHER
  tags          String[]  // Array of strings in Postgres
  enabled       Boolean   @default(true)
  
  bootScriptTemplate String? // Text content for custom iPXE logic
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  diskRules     ProfileDiskLayoutRule[]
  installs      PXEInstall[]
}

model DiskLayout {
  id            String    @id @default(cuid())
  name          String
  syntax        String    // CLOUDINIT_AUTOINSTALL, PRESEED, KICKSTART, SCRIPT
  tags          String[]
  content       String    // The actual layout config text
  enabled       Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profileRules  ProfileDiskLayoutRule[]
  installs      PXEInstall[]
}

model ProfileDiskLayoutRule {
  id            String      @id @default(cuid())
  profileId     String
  diskLayoutId  String
  matchMode     String      @default("OPTIONAL") // OPTIONAL, FORCE

  createdAt     DateTime    @default(now())

  profile       PXEProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  diskLayout    DiskLayout  @relation(fields: [diskLayoutId], references: [id], onDelete: Cascade)
}

model PXEInstall {
  id            String      @id @default(cuid())
  serverId      String
  profileId     String
  diskLayoutId  String?
  
  state         String      @default("QUEUED") // QUEUED, RUNNING, DONE, FAILED
  token         String      @unique // Auth token for callbacks
  
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  lastCallbackAt DateTime?
  logText       String?

  // User Configuration (Password, SSH Keys, etc.)
  userDataJson  Json?

  // Progress Tracking
  progress      Int         @default(0) // 0-100
  stage         String      @default("STARTING") // e.g., "PARTITIONING", "INSTALLING_PACKAGES"

  server        DedicatedServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  profile       PXEProfile      @relation(fields: [profileId], references: [id])
  diskLayout    DiskLayout?     @relation(fields: [diskLayoutId], references: [id])
}

model PXESettings {
  id              String   @id @default(cuid())
  interface       String   @default("ens19")
  dhcpRangeStart  String   @default("10.15.0.100")
  dhcpRangeEnd    String   @default("10.15.0.200")
  subnetMask      String   @default("255.255.255.0")
  leaseTime       String   @default("24h")
  gateway         String   @default("10.15.0.1")
  dnsServer       String   @default("8.8.8.8")
  tftpRoot        String   @default("/srv/tftp")
  httpBootUrl     String   @default("http://10.15.0.2:3000/api/pxe/ipxe")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

